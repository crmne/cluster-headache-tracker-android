<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Attack status shown by the widget is health data and stays on the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="widget_status.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="widget_status.xml" />
    </device-transfer>
</data-extraction-rules>
