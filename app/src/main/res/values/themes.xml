<resources>
    <style name="Base.Theme.ClusterHeadacheTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container</item>
        <item name="colorTertiary">@color/brand_tertiary</item>
        <item name="colorOnTertiary">@color/brand_on_tertiary</item>
        <item name="android:colorBackground">@color/brand_surface</item>
        <item name="colorOnBackground">@color/brand_on_surface</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_on_surface</item>
        <item name="colorSurfaceVariant">@color/brand_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/brand_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/brand_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/brand_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/brand_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/brand_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/brand_surface_container_highest</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="colorOutlineVariant">@color/brand_outline_variant</item>

        <item name="actionMenuTextAppearance">@style/TextAppearance.ClusterHeadacheTracker.ActionMenu</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.ClusterHeadacheTracker.ModalBottomSheet</item>
    </style>

    <!-- Toolbar text buttons (e.g. "Sign Out", "Sponsor") in sentence case like the rest of Material 3. -->
    <style name="TextAppearance.ClusterHeadacheTracker.ActionMenu" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Theme.ClusterHeadacheTracker" parent="Base.Theme.ClusterHeadacheTracker" />

    <!--
      The floating toolbar (Material 3's, TabShell) with the tabs as icons,
      the chosen one with its label on a tonal pill, and New log beside it.
    -->
    <style name="Widget.ClusterHeadacheTracker.FloatingToolbar" parent="Widget.Material3.FloatingToolbar">
        <!-- The dock keeps clear of the system bars itself, for New log too. -->
        <item name="marginLeftSystemWindowInsets">false</item>
        <item name="marginRightSystemWindowInsets">false</item>
        <item name="marginBottomSystemWindowInsets">false</item>
    </style>

    <style name="Widget.ClusterHeadacheTracker.FloatingTab" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:minWidth">@dimen/floating_tab_size</item>
        <item name="android:minHeight">@dimen/floating_tab_size</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">@color/floating_tab_content</item>
        <item name="iconTint">@color/floating_tab_content</item>
        <item name="iconSize">24dp</item>
        <item name="iconGravity">textStart</item>
        <item name="backgroundTint">@color/floating_tab_container</item>
        <item name="shapeAppearance">@style/ShapeAppearance.ClusterHeadacheTracker.Pill</item>
    </style>

    <style name="ShapeAppearance.ClusterHeadacheTracker.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- New log: the primary color, as tall as the toolbar. -->
    <style name="Widget.ClusterHeadacheTracker.NewLogButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="fabCustomSize">@dimen/floating_toolbar_height</item>
        <item name="maxImageSize">28dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ClusterHeadacheTracker.Fab</item>
    </style>

    <style name="ShapeAppearance.ClusterHeadacheTracker.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Shown by the AndroidX SplashScreen API until the first frame, then swapped for the app theme. -->
    <style name="Theme.ClusterHeadacheTracker.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ClusterHeadacheTracker</item>
    </style>

    <!-- Hotwire modals: full-height, edge-to-edge bottom sheets that skip the collapsed state. -->
    <style name="ThemeOverlay.ClusterHeadacheTracker.ModalBottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.ClusterHeadacheTracker.BottomSheet.Modal</item>
        <item name="enableEdgeToEdge">true</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="Widget.ClusterHeadacheTracker.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="behavior_fitToContents">false</item>
        <item name="behavior_expandedOffset">0dp</item>
        <item name="behavior_skipCollapsed">true</item>
        <item name="paddingBottomSystemWindowInsets">true</item>
    </style>
</resources>
