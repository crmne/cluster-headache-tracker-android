<?xml version="1.0" encoding="utf-8"?>
<!--
  The tab shell: a container per tab, which gets its navigator host the
  first time the tab shows (TabShell), and the dock floating over them at the
  bottom: the floating toolbar with the tabs and New log beside it. The root
  doesn't clip the dock, so their shadows show.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/navigator_hosts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/logs_navigator_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/charts_navigator_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/account_navigator_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/feedback_navigator_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dock_margin"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
            android:id="@+id/floating_toolbar"
            style="@style/Widget.ClusterHeadacheTracker.FloatingToolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/tab_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

        </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/new_log"
            style="@style/Widget.ClusterHeadacheTracker.NewLogButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dock_gap"
            android:contentDescription="@string/new_log"
            app:srcCompat="@drawable/ic_new_log" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
